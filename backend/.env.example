# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# ------------------------------------------------------------------------------------------
# Database - option A: Supabase (recommended if you already use it)
# ------------------------------------------------------------------------------------------
# Supabase project > Connect (top bar) > "Session pooler" > copy the URI and put your
# database password in it. If the password has special characters (@ : / ? # %), URL-encode
# them, e.g. @ -> %40. The session pooler works on IPv4 networks; the "Direct connection"
# host (db.<ref>.supabase.co) is IPv6-only on the free plan.
# The transaction pooler (port 6543) also works: prepared statements are switched off for it.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
# TimescaleDB is deprecated on Supabase Postgres 17, so the app uses plain PostgreSQL there:
# a BRIN index on time, date_bin() buckets and an hourly cleanup job instead of policies.
USE_TIMESCALEDB=false
# The free plan has a 500 MB database. One day of 24/7 live simulation is roughly 10-15 MB,
# so keep 3 weeks of raw telemetry (trips, scores and alerts are kept forever).
TELEMETRY_RETENTION_DAYS=21
DATABASE_POOL_MAX=5

# ------------------------------------------------------------------------------------------
# Database - option B: local Docker (TimescaleDB + pgvector), started by `docker compose up -d db`
# ------------------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:drivesense@localhost:5433/drivesense
# USE_TIMESCALEDB=auto
# TELEMETRY_RETENTION_DAYS=90

# ------------------------------------------------------------------------------------------
# Live layer (latest car state, live push, remote commands, leaderboard)
# ------------------------------------------------------------------------------------------
# memory://  = inside the API process. Nothing else to install; right for one car and one
#              API process. It is rebuilt from the database when the backend restarts.
# redis://... = Redis (`docker compose up -d redis`). Needed when you run several API processes.
REDIS_URL=memory://
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------------------
# Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# Leave empty to run fully offline (AI features use template answers + keyword search).
# ------------------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Shared secret sent by vehicles / the fake sensor feeder in the X-Device-Key header
DEVICE_KEY=dev-device-key

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
